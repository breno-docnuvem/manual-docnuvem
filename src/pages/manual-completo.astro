---
// Página única com o manual inteiro, usada só para gerar o PDF (scripts/gerar-pdf.mjs).
// Não aparece no menu nem na busca; fica com noindex.
import { getCollection, render } from 'astro:content';
import logoBranca from '../assets/logo-escuro.svg?raw';
import manual from '../generated/manual.json';
import config from '../../site.config.mjs';
import '../styles/fontes.css';
import '../styles/tokens.css';
import '../styles/impressao.css';

const docs = new Map((await getCollection('docs')).map((d) => [d.id, d]));
const capitulos = [];
for (const item of manual.ordem) {
  const entrada = docs.get(item.slug);
  if (!entrada) continue;
  const { Content } = await render(entrada);
  capitulos.push({ ...item, Content, descricao: entrada.data.description ?? '' });
}
// Capa: texto de apresentação (primeira frase do Docnuvem.md) e os três primeiros módulos como "comece por aqui"
const apresentacao = capitulos.find((c) => c.slug === 'index')?.descricao ?? '';
const modulos = capitulos.filter((c) => c.nivel === 1);
const dataBruta = new Date().toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
const data = dataBruta.charAt(0).toUpperCase() + dataBruta.slice(1);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{config.titulo}</title>
  </head>
  <body data-pagefind-ignore data-base={manual.base}>
    <section class="capa">
      <div class="capa__topo">
        <div class="capa__barra" />
        <div class="capa__logo" set:html={logoBranca} />
        <p class="capa__kicker">Docnuvem / Manual do usuário</p>
        <h1>Manual do usuário</h1>
        <p class="capa__sub">Gestão, armazenamento e assinatura de documentos.</p>
        <p class="capa__texto">{apresentacao}</p>
      </div>
      <div class="capa__modulos">
        <p class="capa__kicker">Neste manual</p>
        <ol>
          {modulos.map((c) => (
            <li><span class="n">{c.numero.padStart(2, '0')}</span>{c.titulo}</li>
          ))}
        </ol>
      </div>
      <p class="capa__rodape">Manual do cliente Docnuvem | Edição {data}</p>
    </section>

    <nav class="indice" aria-label="Índice">
      <p class="cap__kicker">Navegação</p>
      <h1 class="indice__titulo">Índice</h1>
      <ul>
        {capitulos.filter((c) => c.slug !== 'index').map((c) => (
          <li class={`indice__n${Math.min(c.nivel, 3)}`}>
            <a href={`#${c.slug}`}><span class="num">{c.numero}</span> {c.titulo}</a>
          </li>
        ))}
      </ul>
    </nav>

    {capitulos.map((c) => (
      <section id={c.slug} class={`cap cap--n${Math.min(c.nivel, 3)}`} data-slug={c.slug}>
        {c.numero && <p class="cap__kicker">{c.nivel === 1 ? `Módulo ${c.numero.padStart(2, '0')}` : c.numero}</p>}
        <h1 class="cap__titulo">{c.titulo}</h1>
        <div class="conteudo"><c.Content /></div>
      </section>
    ))}

    <script is:inline>
      // Ids repetidos entre páginas (ex.: "1-cadastrar") ganham prefixo; links internos viram âncoras do documento.
      (function () {
        var base = document.body.dataset.base || '/';
        var secoes = {};
        document.querySelectorAll('section.cap').forEach(function (s) {
          secoes[s.dataset.slug] = true;
          s.querySelectorAll('[id]').forEach(function (el) { if (el !== s) el.id = s.dataset.slug + '--' + el.id; });
        });
        document.querySelectorAll('.conteudo a[href]').forEach(function (a) {
          var u = new URL(a.getAttribute('href'), location.href);
          if (u.origin !== location.origin) return;
          var p = u.pathname;
          if (p.indexOf(base) === 0) p = p.slice(base.length);
          p = p.replace(/\/$/, '') || 'index';
          if (!secoes[p]) return;
          a.setAttribute('href', u.hash ? '#' + p + '--' + u.hash.slice(1) : '#' + p);
        });
        document.querySelectorAll('img').forEach(function (i) { i.loading = 'eager'; });
      })();
    </script>
  </body>
</html>
