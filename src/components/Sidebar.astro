---
// Menu lateral: seletor de área (Manual | API) no topo e a busca no topo da gaveta do celular.
import Default from '@astrojs/starlight/components/Sidebar.astro';
const rota = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ehApi = rota.id === 'api' || rota.id.startsWith('api/');
---

<nav class={`dn-areas ${ehApi ? 'dn-area-api' : 'dn-area-manual'}`} aria-label="Áreas do site">
  <a href={base} aria-current={ehApi ? undefined : 'true'}>Manual</a>
  <a href={`${base}api/`} aria-current={ehApi ? 'true' : undefined}>API</a>
</nav>
<button type="button" class="dn-search dn-search--gaveta" data-abrir-busca aria-label="Buscar no manual">
  <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM21 21l-4.3-4.3"></path></svg>
  <span class="ph">Buscar no manual</span>
</button>
<Default><slot /></Default>
